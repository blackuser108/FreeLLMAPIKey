# Server only. Never prefix these names with VITE_ or NEXT_PUBLIC_.
DATABASE_URL=postgresql://freellmapi_runtime.PROJECT_REF:REPLACE_PASSWORD@POOLER_HOST:6543/postgres
CLOUD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CLOUD_SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
CLOUD_ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_SALT_AND_HASH
# Limits below are application guardrails, not provider tier claims.
CLOUD_REQUEST_TIMEOUT_MS=250000
CLOUD_MAX_ATTEMPTS=3
CLOUD_API_RPM=20
