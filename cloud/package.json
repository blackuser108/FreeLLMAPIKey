{
  "name": "freellmapi-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "node ../node_modules/eslint/bin/eslint.js --config eslint.config.mjs src scripts test public/app.js",
    "test:database": "node --env-file=../.cloud-private/runtime.env --test test/database.integration.mjs",
    "dev": "node --env-file=../.cloud-private/runtime.env scripts/dev.mjs"
  },
  "dependencies": {
    "fast-uri": "3.1.9",
    "postgres": "3.4.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
